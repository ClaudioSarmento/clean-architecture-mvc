@using CleanArchMvc.Application.DTOs;
@model IReadOnlyList<ProductDTO>;

@{
    ViewData["Title"] = "Products Management";
}


<div>
    <h2>@ViewData["Title"]</h2>
</div>
<div class="pull-left">
    <a asp-action="Create" class="btn btn-primary">
        <span title="Register New" class="fas fa-plus">Register New</span>
    </a>
</div>
@if (Model == null || !Model.Any())
{
    <p>Nenhum produto encontrado.</p>
}
else
{
    <div class="panel panel-default">
        <table class="table talbe-striped">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.First().Id)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().Description)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().Stock)
                    </th>
                    <th>Edit</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var produto in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => produto.Id)</td>
                        <td>@Html.DisplayFor(modelItem => produto.Name)</td>
                        <td>@Html.DisplayFor(modelItem => produto.Description)</td>
                        <td>@Html.DisplayFor(modelItem => produto.Stock)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@produto.Id" title="Edit" class="btn-warning">
                                <span class="fas fa-edit">Edit</span>
                            </a>
                        </td>
                        <td>
                            <a asp-action="Delete" asp-route-id="@produto.Id" title="Delete" class="btn-danger">
                                <span class="fas fa-trash-alt">Delete</span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

}